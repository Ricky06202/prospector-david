# ============================================================
#  Configuración del pipeline Prospector David
#  Modelo: Nube Privada Soberana (IaaS) — suscripciones $10/$25/$50 al mes.
#  Copia este archivo a .env y completa los valores.
# ============================================================

# LINK de tu plataforma (registro/pago). Se entrega en el MENSAJE 2 cuando el
# contacto responde; en la apertura jamás van enlaces. Sin URL, el mensaje 2
# ofrece pasarlo por correo.
PLATAFORMA_URL=

# MÓDULO 1 — Fuente de datos del directorio/catálogo de empresas.
# URL del catálogo local de Chiriquí (HTML estático o público).
PROSPECTO_DIR_URL=

# EMBUDO ÚNICO (suscripción nube $10-50/mes): la web propia NO influye. Público
# para velocidad: independientes/creadores + pequeños negocios con datos
# sensibles. Excluidos: corporativos (SCORE_RESENAS_MAX) y buscadores de dev custom.
# Los leads viejos del embudo de landings quedan tipo_lead="upsell" y excluidos.
# NICHO filtra por giro al generar copys (ej: Abogado, Fotógrafo).
NICHO=

# MÓDULO 3 — Ruta al binario de Chromium (para las capturas).
# En esta laptop se usa el Chromium de nix; en Docker usa /usr/bin/chromium.
CHROMIUM_PATH=/nix/store/rxf83sv2x0ja1hi6vdli6ijll5v15x9j-chromium-151.0.7922.173/bin/chromium
# CHROMIUM_PATH=/usr/bin/chromium   # (Docker/NAS)

# MÓDULO 4 — API de DeepSeek para generar copys (opcional; sin key usa plantillas).
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT=20000

# GOOGLE PLACES API (oficial, sin captchas): key de Google Cloud con Places API habilitada + billing.
# El crédito gratuito de $200/mes cubre miles de búsquedas.
GOOGLE_PLACES_API_KEY=
# Por defecto busca TODA la provincia de Chiriquí (provincia + Boquete, Volcán, Bugaba,
# La Concepción, Puerto Armuelles, Alanje). Usa PLACES_QUERIES para personalizar.
PLACES_QUERIES=
# Máx resultados por búsqueda (con PAGINACIÓN: la API da 20 por página, hasta 60).
PLACES_LIMITE=60
# Presupuesto total de requests por corrida (evita quemar la cuota diaria).
PLACES_REQUESTS_MAX=300
# Días de descanso para queries que ya no producen leads nuevos (ahorra cuota).
# Las queries nunca corridas van PRIMERO; las que produjeron nuevos se re-corren al día siguiente.
PLACES_COOLDOWN_DIAS=30

# LEAD SCORING (giros sensibles + independientes; retail/gastro/corporativos fuera)
# SCORE_MODO=filter (DEFAULT) → entran solo el público objetivo con score >= umbral.
# SCORE_MODO=rank → no descarta a nadie (volumen), el score solo ordena.
SCORE_MODO=filter
SCORE_RATING_MIN=4.0
SCORE_RESENAS_MIN=10
SCORE_MINIMO=45
# Proxy de "corporativo lento/large": negocios con MÁS reseñas que esto se excluyen
# (compras con comité = fricción; acá buscamos decisión rápida).
SCORE_RESENAS_MAX=600
SCORE_TOPN=0
# Chequeo ligero de la calidad de la web propia (HTTP, no renderiza): las webs
# "deficientes" (caídas, sin vista móvil, casi vacías) SÍ se mantienen como leads.
# ANALIZAR_WEB_LIMITE acota cuántas webs se analizan por corrida (evita demoras).
ANALIZAR_WEB=true
ANALIZAR_WEB_LIMITE=200

# COTIZADOR — los 3 planes de la plataforma (la única oferta que existe)
PRECIO_BASICO=10     # 50GB E2E — respaldo personal
PRECIO_PRO=25        # 200GB + sync móvil + backup diario — freelancers
PRECIO_NEGOCIO=50    # 500GB + 3 usuarios + soporte prioritario — equipos
# Pago: USDC sin comisiones, o transferencia bancaria (+10%) — fijo en el copy.
# Empresa matriz que respalda el servicio (autoridad + garantía).
MATRIZ_NOMBRE=Topografía Especializada S.A.
MATRIZ_RUBRO=Empresa de ingeniería y desarrollo de software
MATRIZ_UBICACION=David, Chiriquí · República de Panamá
MATRIZ_CONTACTO=WhatsApp 6510-4147

# ANTI-BAN DE WHATSAPP (envío manual): volumen 30-50 leads/día con ritmo humano.
WA_DELAY_BASE=30000        # base (ms) entre mensajes
WA_DELAY_JITTER=60000      # jitter aleatorio extra (ms)
WA_FACTOR_NOCTURNO=2.5     # x2.5 entre 22h-7h (0 = desactivado)
WA_PAUSA_CADA=10           # pausa larga cada N envíos
WA_PAUSA_MIN=20            # pausa larga mínima (minutos)
WA_PAUSA_MAX=45            # pausa larga máxima (minutos)
WA_MAX_SESION=40           # tope DIARIO de contactos (meta 30-50; NUNCA >50)
# DAVID: el MENSAJE 1 jamás lleva enlaces (miedo a estafas) ni menciona
# crypto/USDC. El link de activación (PLATAFORMA_URL) se manda SOLO en el
# mensaje 2, cuando el contacto ya respondió. Las capturas de landings: legacy.
ENVIAR_ENLACES=false
URL_PUBLICA=

# CAPTURAS (pipeline de prototipado)
# SS_SALTAR=true omite prospectos ya capturados y frescos (ahorra recursos).
# SS_FORMATO=jpeg (recomendado: 6 imágenes ≈ 1MB, cargan al instante en WhatsApp).
#   png|jpeg|webp · SS_CALIDAD=80 → controla el peso.
SS_SALTAR=true
SS_FORZAR=false
SS_FORMATO=jpeg
SS_CALIDAD=80
SS_REINICIAR=15
