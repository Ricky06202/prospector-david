# ============================================================
#  Configuración del pipeline Prospector David
#  Copia este archivo a .env y completa los valores.
# ============================================================

# MÓDULO 1 — Fuente de datos del directorio/catálogo de empresas.
# URL del catálogo local de Chiriquí (HTML estático o público).
PROSPECTO_DIR_URL=

# TRACK UPSELL (Places): los negocios con web buena YA NO se descartan — entran
# marcados como tipo_lead="upsell" (candidatos a dashboard $1,200) y quedan FUERA
# del lote de $300. SOLO_SIN_WEB sigue aplicando a googlemaps/camchi.
# SOLO_SIN_WEB=true

# MÓDULO 3 — Ruta al binario de Chromium (para las capturas).
# En esta laptop se usa el Chromium de nix; en Docker usa /usr/bin/chromium.
CHROMIUM_PATH=/nix/store/rxf83sv2x0ja1hi6vdli6ijll5v15x9j-chromium-151.0.7922.173/bin/chromium
# CHROMIUM_PATH=/usr/bin/chromium   # (Docker/NAS)

# MÓDULO 4 — API de DeepSeek para generar copys (opcional; sin key usa plantillas).
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT=20000

# GOOGLE PLACES API (oficial, sin captchas): key de Google Cloud con Places API habilitada + billing.
# El crédito gratuito de $200/mes cubre miles de búsquedas.
GOOGLE_PLACES_API_KEY=
# Por defecto busca TODA la provincia de Chiriquí (provincia + Boquete, Volcán, Bugaba,
# La Concepción, Puerto Armuelles, Alanje). Usa PLACES_QUERIES para personalizar.
PLACES_QUERIES=
# Máx resultados por búsqueda (con PAGINACIÓN: la API da 20 por página, hasta 60).
PLACES_LIMITE=60
# Presupuesto total de requests por corrida (evita quemar la cuota diaria).
PLACES_REQUESTS_MAX=300
# Días de descanso para queries que ya no producen leads nuevos (ahorra cuota).
# Las queries nunca corridas van PRIMERO; las que produjeron nuevos se re-corren al día siguiente.
PLACES_COOLDOWN_DIAS=30

# LEAD SCORING
# SCORE_MODO=rank (DEFAULT) → el score solo ORDENA (mejores primero). NADIE se
#   descarta por reputación: entra todo negocio con teléfono válido y sin web buena.
#   Así mantienes VOLUMEN de leads para trabajar meses (~220/mes).
# SCORE_MODO=filter → modo estricto: solo pasan los que cumplen los umbrales.
SCORE_MODO=rank
SCORE_RATING_MIN=4.0
SCORE_RESENAS_MIN=15
SCORE_MINIMO=45
SCORE_TOPN=0
# Chequeo ligero de la calidad de la web propia (HTTP, no renderiza): las webs
# "deficientes" (caídas, sin vista móvil, casi vacías) SÍ se mantienen como leads.
# ANALIZAR_WEB_LIMITE acota cuántas webs se analizan por corrida (evita demoras).
ANALIZAR_WEB=true
ANALIZAR_WEB_LIMITE=200

# COTIZADOR — precios base (ajústalos a tu estructura de costos)
PRECIO_LANDING=300
PRECIO_CATALOGO_BASE=400
PRECIO_POR_PRODUCTO=2
PRECIO_ECOMMERCE=800
PRECIO_MANTENIMIENTO=25
# Nivel 2 del upsell institucional (desde).
PRECIO_PLATAFORMA=1200
# Empresa matriz que respalda el Nivel 2 (autoridad + garantía).
MATRIZ_NOMBRE=Topografía Especializada S.A.
MATRIZ_RUBRO=Empresa de ingeniería y desarrollo de software
MATRIZ_UBICACION=David, Chiriquí · República de Panamá
MATRIZ_CONTACTO=WhatsApp 6510-4147

# ANTI-BAN DE WHATSAPP (envío manual): delays dinámicos entre envíos.
WA_DELAY_BASE=45000        # base (ms) entre mensajes
WA_DELAY_JITTER=90000      # jitter aleatorio extra (ms)
WA_FACTOR_NOCTURNO=2.5     # x2.5 entre 22h-7h (0 = desactivado)
WA_PAUSA_CADA=8            # pausa larga cada N envíos
WA_PAUSA_MIN=30            # pausa larga mínima (minutos)
WA_PAUSA_MAX=60            # pausa larga máxima (minutos)
WA_MAX_SESION=0            # tope de envíos por sesión (0 = sin tope)
# DAVID: NUNCA se mandan enlaces (miedo a estafas). El mensaje 2 y la retoma
# acompañan solo las IMÁGENES del prototipo. Dejar ENVIAR_ENLACES=false.
# (URL_PUBLICA se ignora mientras ENVIAR_ENLACES=false.)
ENVIAR_ENLACES=false
URL_PUBLICA=

# CAPTURAS (pipeline de prototipado)
# SS_SALTAR=true omite prospectos ya capturados y frescos (ahorra recursos).
# SS_FORMATO=jpeg (recomendado: 6 imágenes ≈ 1MB, cargan al instante en WhatsApp).
#   png|jpeg|webp · SS_CALIDAD=80 → controla el peso.
SS_SALTAR=true
SS_FORZAR=false
SS_FORMATO=jpeg
SS_CALIDAD=80
SS_REINICIAR=15
